# ---------------------------------------------------------------------------
# RCC LIBRO — environment
# Copy to .env.local (never commit the real values).
# ---------------------------------------------------------------------------

# Supabase project  →  Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...                       # safe in the browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...                           # SERVER ONLY — never prefix NEXT_PUBLIC

# Server-only escape hatch for the containerized stack: the browser must reach
# Supabase at the published loopback URL above, while the Next.js server inside
# the docker network reaches it at the in-network hostname. Leave unset for a
# hosted project. See docker/README-style notes in README.md.
# SUPABASE_INTERNAL_URL=http://kong:8000

# Canonical origin. Used for OAuth redirects, QR payloads and e-mail links.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Outbound e-mail — borrow confirmations, 7/3/1-day reminders, overdue notices.
# Leave everything blank in development: messages are journalled to email_logs
# and printed to the server log instead of being sent.
#
# Two transports exist and the app picks whichever is filled in (SMTP wins).
# Force one with MAIL_PROVIDER=smtp|resend|console.
#
# Gmail: Google account → Security → 2-Step Verification → App passwords,
# create one named for the library system. Gmail only lets the authenticated
# account appear in the From line, so MAIL_FROM must be MAIL_SMTP_USER.
MAIL_PROVIDER=
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=465
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
# 465 is implicit TLS; set false for STARTTLS on 587/2525.
MAIL_SMTP_SECURE=
# The display name is always "RCC LIBRO"; only the mailbox is configurable.
MAIL_FROM=

RESEND_API_KEY=
RESEND_FROM_ADDRESS="RCC LIBRO <library@rcc.edu.ph>"

# Shared secret protecting /api/cron/reminders. Vercel Cron sends it as
# "Authorization: Bearer <secret>". Generate one: openssl rand -hex 32
CRON_SECRET=
