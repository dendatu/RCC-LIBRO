{
  "name": "rcc-libro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed:images": "node scripts/generate-library-placeholders.mjs",
    "schema:sql": "node scripts/build-schema-sql.mjs",
    "demo:accounts": "node scripts/create-demo-accounts.mjs",
    "reminders": "node scripts/run-reminders.mjs",
    "validate:sql": "bash scripts/validate-sql.sh",
    "docker:up": "docker compose -f docker/docker-compose.yml --env-file docker/.env up -d --build",
    "docker:demo": "docker compose -f docker/docker-compose.yml --env-file docker/.env --profile demo run --rm demo-accounts && docker compose -f docker/docker-compose.yml --env-file docker/.env --profile demo run --rm seed",
    "docker:logs": "docker compose -f docker/docker-compose.yml --env-file docker/.env logs --tail 80",
    "docker:reminders": "docker compose -f docker/docker-compose.yml --env-file docker/.env exec mailer node scripts/run-reminders.mjs",
    "docker:down": "docker compose -f docker/docker-compose.yml --env-file docker/.env down",
    "docker:reset": "docker compose -f docker/docker-compose.yml --env-file docker/.env down -v"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.6.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.61.0",
    "next": "15.5.28",
    "nodemailer": "^10.2.1",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.10.1",
    "resend": "^6.34.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "description": "RCC LIBRO — Library Inventory and Book Recording Organizer for Republic Central Colleges"
}
