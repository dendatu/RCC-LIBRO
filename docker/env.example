# ---------------------------------------------------------------------------
# RCC LIBRO — self-hosted stack
# Copy to docker/.env, then `docker compose up` from the docker/ directory.
#
# Every value below is a LOCAL DEVELOPMENT credential that ships in this repo
# on purpose: the stack only listens on the machine's loopback interface and
# the keys are signed with the JWT secret next to them. Replace JWT_SECRET and
# both keys before exposing the stack to a network, and rotate DEMO_PASSWORD
# (it is the shared password for the seven demo logins).
# ---------------------------------------------------------------------------

# Shared secret that signs the API keys below and every session token.
SUPABASE_JWT_SECRET=6dc78d33cb53e1cf0d354ecbeb6464a3c6480845876d811abd46426873bf0e5e

# HS256 tokens signed with the secret above. `apikey` may be the anon key;
# server-side admin calls need the service_role key.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhdWQiOiJhdXRoZW50aWNhdGVkIiwicm9sZSI6ImFub24iLCJpc3MiOiJyY2MtbGlicm8tbG9jYWwiLCJpYXQiOjE3OTMwMjA2NDMsImV4cCI6MjEwODM4MDY0M30.EmRypGptfkHig05B2NnqMAz9algec9cHMTgow1ilGmM
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhdWQiOiJhdXRoZW50aWNhdGVkIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlzcyI6InJjYy1saWJyby1sb2NhbCIsImlhdCI6MTc5MzAyMDY0MywiZXhwIjoyMTA4MzgwNjQzfQ.AGlBDmTrN3t7xLPP9-vDwpKY7E3lUF2qVxL8zsBwgQ8

# Database password. The Supabase image gives every managed role
# (postgres, supabase_auth_admin, authenticator, …) this same password.
POSTGRES_PASSWORD=rcc_library_local

# Public origin of the app, and the API gateway the browser talks to.
# Changing a port here means rebuilding the app image: NEXT_PUBLIC_* values are
# inlined into the browser bundle at build time.
SITE_URL=http://localhost:3000
KONG_HTTP_PORT=8000
APP_HTTP_PORT=3000

# Password for the seven demo logins created by `compose run demo-accounts`.
DEMO_PASSWORD=RccLibrary#2026

# Optional: outbound e-mail. Empty means reminders are journalled to
# email_logs and printed to the server log instead of being sent.
RESEND_API_KEY=
RESEND_FROM_ADDRESS="RCC LIBRO <onboarding@resend.dev>"

# Optional: shared secret for POST /api/cron/reminders inside the app.
CRON_SECRET=

# Optional Google SSO. Set GOOGLE_ENABLED=true, fill the two credentials and
# restart gotrue to light up the "Continue with Google" button; the Google OAuth
# client must allow http://localhost:8000/auth/v1/callback as a redirect URI.
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional SMTP for GoTrue's password-reset e-mail (Mailpit is the usual local
# choice). Sign-in, sign-up and the whole catalogue work without it.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
